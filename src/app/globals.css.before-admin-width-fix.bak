@import "tailwindcss";

:root {
  --muhaj-navy: #061a3a;
  --muhaj-navy-dark: #031229;
  --muhaj-navy-soft: #0b2855;
  --muhaj-gold: #d4af37;
  --muhaj-gold-dark: #a98216;
  --muhaj-gold-light: #f0d878;
  --muhaj-cream: #f8f3e7;
  --muhaj-white: #ffffff;
  --muhaj-text: #172033;
  --muhaj-muted: #667085;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--muhaj-cream);
  color: var(--muhaj-text);
  font-family: Arial, Helvetica, sans-serif;
}

button,
a,
input,
select,
textarea {
  font: inherit;
}

::selection {
  background: var(--muhaj-gold);
  color: var(--muhaj-navy-dark);
}

/* ==========================================================
   MUHAJ ADMIN MODULE CONTENT FRAME
   Dashboard keeps its existing layout.
   Other admin modules use this shared frame.
========================================================== */

.admin-module-frame {
  width: 100%;
  max-width: 1440px;
  margin-left: auto;
  margin-right: auto;
  padding: 1.5rem 1rem 2.5rem;
}

@media (min-width: 640px) {
  .admin-module-frame {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .admin-module-frame {
    padding-left: 2rem;
    padding-right: 2rem;
    padding-top: 2rem;
  }
}

@media (min-width: 1280px) {
  .admin-module-frame {
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }
}

.admin-module-frame > * {
  min-width: 0;
}

.admin-module-frame section {
  min-width: 0;
}

.admin-module-frame table {
  border-collapse: separate;
  border-spacing: 0;
}
